# 값은 Vercel의 환경 변수 화면에만 둔다. 이 파일은 이름과 설명만.
# 검증 규칙: src/lib/config.ts · docs/architecture/backend.md 11절

# 백엔드 주소 (서버 전용 — NEXT_PUBLIC_을 붙이지 않는다)
API_URL=http://localhost:4000
# 백엔드와 같은 값, 32바이트 이상 (서버 전용)
PROXY_SECRET=
# 백엔드의 DEMO_PASSWORD와 같은 값. 로그인 화면의 데모 계정 [채워 넣기]에 쓴다. 없으면 안내를 숨긴다
DEMO_PASSWORD=
