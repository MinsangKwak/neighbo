{
  "name": "@neighbo/project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint tests",
    "typecheck": "tsc -p tests/shared-schema/tsconfig.json && tsc -p tests/backend-node/tsconfig.json && tsc -p tests/frontend-react/tsconfig.json",
    "test": "npm run test:shared && npm run test:api && npm run test:web",
    "test:shared": "npm run test -w @neighbo/shared-schema",
    "test:api": "npm run test -w @neighbo/backend-node",
    "test:web": "npm run test -w @neighbo/frontend-react",
    "test:docs": "npm run test:docs -w @neighbo/backend-node",
    "test:e2e": "npm run e2e -w @neighbo/frontend-react"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "jsdom": "^31.0.0",
    "openapi-types": "12.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
