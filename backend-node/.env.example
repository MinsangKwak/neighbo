# 값은 각 플랫폼의 환경 변수 화면에만 둔다. 이 파일은 이름과 설명만.
# 검증 규칙: src/config.ts · docs/architecture/backend.md 11절

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://neighbo:neighbo@127.0.0.1:5432/neighbo_dev

# 32바이트 이상. 만들기: openssl rand -base64 48
JWT_SECRET=
PROXY_SECRET=

# 쓰기 요청의 Origin 검사 · 소켓 CORS
ALLOWED_ORIGIN=http://localhost:3000
# staging의 미리보기 주소 정규식. production에 값이 있으면 부팅 실패
ALLOWED_ORIGIN_PATTERN=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
# STORAGE_DRIVER=s3일 때
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

BCRYPT_COST=12
LOG_LEVEL=info

# 시드 실행 때만. 8자 이상
DEMO_PASSWORD=
# 1이면 샘플 데이터(사용자 10 · 상품 60 · 방 15 · 메시지 300)도 넣는다. DEMO_PASSWORD가 있어야 한다
SEED_SAMPLE=
