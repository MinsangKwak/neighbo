{
  "name": "@neighbo/backend-node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prestart": "prisma generate",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/run.ts"
  },
  "dependencies": {
    "@neighbo/shared-schema": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "^6.0.0",
    "busboy": "^1.6.0",
    "express": "^5.3.0",
    "pg": "^8.13.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^10.14.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
